<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TPECOM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TPECOM.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Main Navigation -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">
                    <span class="text-primary">TP</span><span class="text-dark">ECOM</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/">Accueil</a>
                        </li>
                       
                            <li class="nav-item">
                                <a class="nav-link fw-medium" href="/Products/Index">Produits</a>
                            </li>
                        
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/Home/About">À propos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/Home/Contact">Contact</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <form class="d-none d-lg-flex me-3 position-relative" action="/Products/Search" method="get">
                            <input class="form-control rounded-pill pe-5" type="search" name="q" placeholder="Rechercher..." aria-label="Search" style="min-width: 200px;">
                            <button class="btn position-absolute end-0 top-0 bottom-0" type="submit"><i class="bi bi-search"></i></button>
                        </form>
                        <div class="d-flex">
                            <div class="dropdown me-3">
                                <button class="btn btn-outline-dark rounded-circle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-person"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    @if (Context.Session.GetString("User_Email") != null)
                                    {
                                        <li>
                                            <span class="dropdown-item-text">
                                                <strong>Bonjour, @Context.Session.GetString("User_FirstName")</strong>
                                            </span>
                                        </li>
                                        <li><a class="dropdown-item" href="/Account/Profile">Mon profil</a></li>
                                        @if (Context.Session.GetString("User_Type") == "Vendeur")
                                        {
                                            <li><a class="dropdown-item" href="/Seller/Dashboard">Tableau de bord</a></li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/Account/Logout">Déconnexion</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" href="/Account/Login">Connexion</a></li>
                                        <li><a class="dropdown-item" href="/Account/Register">Inscription</a></li>
                                    }
                                </ul>
                            </div>
                            <a href="/Cart/Index" class="btn btn-outline-dark rounded-circle position-relative" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-cart3"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">
                                    @(Context.Session.GetInt32("Cart_Count") ?? 0)
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <main class="flex-grow-1">
        @RenderBody()
    </main>
    
    <!-- Footer intégré directement -->
    <footer class="footer bg-dark text-white">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <h5>À propos</h5>
                    <p class="text-muted mb-2">Notre boutique en ligne vous propose une large gamme de produits de qualité à des prix compétitifs.</p>
                </div>
                <div class="col-md-4 mb-2">
                    <h5>Liens rapides</h5>
                    <ul class="list-unstyled mb-2">
                        <li><a href="/" class="text-white-50">Accueil</a></li>
                        @if (Context.Session.GetString("User_Email") != null)
                        {
                            <li><a href="/Products" class="text-white-50">Produits</a></li>
                            <li><a href="/Cart" class="text-white-50">Panier</a></li>
                        }
                        <li><a href="/Home/Contact" class="text-white-50">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-2">
                    <h5>Contact</h5>
                    <address class="text-muted mb-0">
                        <strong>Nom de l'entreprise</strong><br>
                        123 Rue Exemple, 75000 Paris<br>
                        <abbr title="Téléphone">Tél:</abbr> (123) 456-7890<br>
                        <a href="mailto:contact@example.com" class="text-white-50">contact@example.com</a>
                    </address>
                </div>
            </div>
            <div class="row border-top border-secondary pt-2">
                <div class="col-md-6 text-center text-md-start">
                    <p class="text-muted mb-0">&copy; @DateTime.Now.Year - Votre Entreprise</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item"><a href="#" class="text-white-50"><i class="bi bi-facebook"></i></a></li>
                        <li class="list-inline-item"><a href="#" class="text-white-50"><i class="bi bi-twitter"></i></a></li>
                        <li class="list-inline-item"><a href="#" class="text-white-50"><i class="bi bi-instagram"></i></a></li>
                        <li class="list-inline-item"><a href="#" class="text-white-50"><i class="bi bi-linkedin"></i></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
