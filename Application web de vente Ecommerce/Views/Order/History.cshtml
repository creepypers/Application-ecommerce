@model List<TPECOM.Models.Order>
@{
    ViewData["Title"] = "Historique des commandes";
}

<div class="container py-5">
    <h1 class="h3 mb-4">Historique des commandes</h1>
    
    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <i class="bi bi-bag-x display-1 text-muted mb-3"></i>
                <h3>Aucune commande</h3>
                <p class="text-muted mb-4">Vous n'avez pas encore passé de commande.</p>
                <a href="/Products/Index" class="btn btn-dark">Parcourir les produits</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Commande #</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th>Total</th>
                            <th>Facture</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(order.Status == TPECOM.Models.OrderStatus.Delivered ? "bg-success" : 
                                                        order.Status == TPECOM.Models.OrderStatus.Shipped ? "bg-primary" : 
                                                        order.Status == TPECOM.Models.OrderStatus.Processing ? "bg-info" : 
                                                        order.Status == TPECOM.Models.OrderStatus.Pending ? "bg-warning" : 
                                                        order.Status == TPECOM.Models.OrderStatus.Cancelled ? "bg-danger" : 
                                                        order.Status == TPECOM.Models.OrderStatus.Refunded ? "bg-secondary" : "bg-dark")">
                                        @order.Status.ToString()
                                    </span>
                                </td>
                                <td>$@order.Total.ToString("0.00")</td>
                                <td>
                                    @if (order.Invoice != null)
                                    {
                                        <a href="/Order/Invoice/@order.Invoice.Id" class="text-decoration-none">
                                            @order.Invoice.InvoiceNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">En attente</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Order/Details/@order.Id" class="btn btn-sm btn-outline-dark me-1">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (order.Invoice != null)
                                    {
                                        <a href="/Order/Invoice/@order.Invoice.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    
    <div class="mt-4">
        <a href="/Account/Profile" class="btn btn-outline-dark">
            <i class="bi bi-person me-2"></i>Retour au profil
        </a>
    </div>
</div> 