@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="h2 mb-4">Contactez-nous</h1>
            
            <div class="row mb-5">
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-geo-alt fs-1 text-primary"></i>
                            </div>
                            <h5 class="card-title">Adresse</h5>
                            <p class="card-text">18 Rue Saint-Etienne<br>Levis, QC, Canada</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-telephone fs-1 text-primary"></i>
                            </div>
                            <h5 class="card-title">Téléphone</h5>
                            <p class="card-text">+1 (873) 455-9919</p>
                            <p class="card-text text-muted small">Lun-Ven: 9h-18h</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-envelope fs-1 text-primary"></i>
                            </div>
                            <h5 class="card-title">Email</h5>
                            <p class="card-text">contact@tpecom.com</p>
                            <p class="card-text text-muted small">Nous répondons sous 24h</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm mb-5">
                <div class="card-body p-4 p-md-5">
                    <h2 class="h4 mb-4">Envoyez-nous un message</h2>
                    
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="name" class="form-label">Nom complet</label>
                                <input type="text" class="form-control" id="name" placeholder="Votre nom">
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" placeholder="votre@email.com">
                            </div>
                            <div class="col-12">
                                <label for="subject" class="form-label">Sujet</label>
                                <input type="text" class="form-control" id="subject" placeholder="Sujet de votre message">
                            </div>
                            <div class="col-12">
                                <label for="message" class="form-label">Message</label>
                                <textarea class="form-control" id="message" rows="5" placeholder="Votre message"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-dark">Envoyer le message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="mb-5">
                <h2 class="h4 mb-4">Notre emplacement</h2>
                <div class="ratio ratio-16x9">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5461.787552777857!2d-71.18156429999999!3d46.806398300000005!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cb895bbf4a711df%3A0x149f9324cb85e340!2s18%20Rue%20Saint-%C3%89tienne%2C%20L%C3%A9vis%2C%20QC%20G6V%205R6!5e0!3m2!1sfr!2sca!4v1743311432029!5m2!1sfr!2sca" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>                </div>
            </div>
            
            <div class="mb-5">
                <h2 class="h4 mb-4">FAQ</h2>
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item border-0 mb-3 shadow-sm">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                Quels sont vos délais de livraison ?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Nos délais de livraison standard sont de 2 à 5 jours ouvrables au Canada. Pour les livraisons internationales, comptez entre 5 et 10 jours ouvrables selon la destination.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0 mb-3 shadow-sm">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                Comment puis-je suivre ma commande ?
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Une fois votre commande expédiée, vous recevrez un email contenant un numéro de suivi. Vous pourrez utiliser ce numéro sur notre site dans la section "Suivi de commande" ou directement sur le site du transporteur.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0 mb-3 shadow-sm">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                Quelle est votre politique de retour ?
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Vous disposez de 14 jours à compter de la réception de votre commande pour nous retourner un article. Les produits doivent être retournés dans leur état d'origine, non utilisés et dans leur emballage d'origine. Les frais de retour sont à la charge du client sauf en cas de produit défectueux.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 