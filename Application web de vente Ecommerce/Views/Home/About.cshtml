@{
    ViewData["Title"] = "À propos de nous";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="h2 mb-4">À propos de TPECOM</h1>
            
            <div class="mb-5">
                <h2 class="h4 mb-3">Notre histoire</h2>
                <p>Fondée en 2025, TPECOM est une entreprise qui propose des produits de qualité supérieure à des prix abordables.</p>
                <p>Nous sommes une équipe de passionnés qui partagent la même vision : offrir des produits de qualité supérieure à des prix abordables.</p>
            </div>
            
            <div class="mb-5">
                <h2 class="h4 mb-3">Notre mission</h2>
                <p>Chez TPECOM, notre mission est simple : vous offrir des produits de qualité supérieure à des prix abordables. Nous nous engageons à :</p>
                <ul>
                    <li>Proposer des produits de qualité supérieure à des prix abordables</li>
                    <li>Offrir un service client réactif et personnalisé</li>
                    <li>Contribuer positivement à notre communauté et à l'environnement</li>
                </ul>
            </div>
            
            
            
            <div class="mb-5">
                <h2 class="h4 mb-3">Nos valeurs</h2>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="bi bi-star fs-2 text-primary"></i>
                            </div>
                            <div class="ms-3">
                                <h5>Qualité</h5>
                                <p>Nous ne proposons que des produits qui répondent à nos normes élevées de qualité et de performance.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="bi bi-people fs-2 text-primary"></i>
                            </div>
                            <div class="ms-3">
                                <h5>Service client</h5>
                                <p>Nous plaçons nos clients au centre de tout ce que nous faisons, en offrant un service personnalisé et attentif.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="bi bi-lightbulb fs-2 text-primary"></i>
                            </div>
                            <div class="ms-3">
                                <h5>Innovation</h5>
                                <p>Nous sommes constamment à la recherche de nouvelles technologies et de solutions innovantes.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="bi bi-globe fs-2 text-primary"></i>
                            </div>
                            <div class="ms-3">
                                <h5>Responsabilité</h5>
                                <p>Nous nous engageons à opérer de manière éthique et durable, en minimisant notre impact environnemental.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-5">
                <p class="mb-4">Vous souhaitez en savoir plus sur TPECOM ou nous contacter ?</p>
                <a href="/Home/Contact" class="btn btn-dark">Contactez-nous</a>
            </div>
        </div>
    </div>
</div> 