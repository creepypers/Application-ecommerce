@model List<TPECOM.Models.Product>
@{
    ViewData["Title"] = "Tableau de bord vendeur";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Tableau de bord vendeur</h1>
        <a href="/Seller/AddProduct" class="btn btn-dark">Ajouter un produit</a>
    </div>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["SuccessMessage"]
        </div>
    }
    
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h4 mb-4">Mes produits</h2>
            
            @if (Model.Count == 0)
            {
                <p class="text-center my-5">Vous n'avez pas encore ajouté de produits.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Image</th>
                                <th scope="col">Nom</th>
                                <th scope="col">Catégorie</th>
                                <th scope="col">Prix</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>@product.Id</td>
                                    <td>
                                        <img src="@product.ImageUrl" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover;">
                                    </td>
                                    <td>@product.Name</td>
                                    <td>@product.Category</td>
                                    <td>$@product.Price.ToString("0.00")</td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="/Seller/EditProduct/@product.Id" class="btn btn-sm btn-outline-dark">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form action="/Seller/DeleteProduct" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@product.Id">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h4 mb-4">Statistiques</h2>
            
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card border-0 bg-light h-100">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-box-seam fs-1 text-primary"></i>
                            </div>
                            <h5 class="card-title">Produits</h5>
                            <p class="card-text display-6">@Model.Count</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 bg-light h-100">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-cart-check fs-1 text-primary"></i>
                            </div>
                            <h5 class="card-title">Commandes</h5>
                            <p class="card-text display-6">0</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 bg-light h-100">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-currency-euro fs-1 text-primary"></i>
                            </div>
                            <h5 class="card-title">Ventes</h5>
                            <p class="card-text display-6">$0.00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 